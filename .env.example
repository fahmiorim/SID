# ============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
# JANGAN pernah meng-commit file `.env` yang berisi nilai asli.
# ============================================================================

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
NODE_ENV=development

# URL publik aplikasi (dipakai untuk absolute URL, OAuth callback, dsb.)
APP_URL=http://localhost:3000

# Nama aplikasi. Berawalan NEXT_PUBLIC_ sehingga AMAN dipakai di sisi client.
# Di-inline saat build — ubah nilainya memerlukan build ulang.
NEXT_PUBLIC_APP_NAME=Sistem Informasi Desa

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Buat database-nya lebih dulu: npm run db:create
DATABASE_URL=mysql://root:@127.0.0.1:3306/desa_dev

# ---------------------------------------------------------------------------
# Autentikasi (better-auth)
# ---------------------------------------------------------------------------
# WAJIB diganti. Buat nilai acak (minimal 32 karakter), contoh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seeder (opsional — hanya dibaca oleh `npm run db:seed`)
# ---------------------------------------------------------------------------
# Bila dibiarkan kosong, seeder memakai nilai bawaan: admin / Admin#12345.
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
